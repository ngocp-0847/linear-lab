{
  "name": "linear-lab",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @lab/api & npm run dev -w @lab/web",
    "build": "npm run build -w @lab/shared && npm run build -w @lab/db && npm run build -w @lab/api && npm run build -w @lab/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @lab/db",
    "db:migrate": "npm run db:migrate -w @lab/db",
    "db:seed": "npm run db:seed -w @lab/db",
    "check:stack": "bash tools/check-stack.sh"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
